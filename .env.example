# Copy to .env.local (or .env) and adjust. Every variable is optional.

# External PostgreSQL. Leave unset to use the embedded PGlite engine in ./data/postgres
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divorce_db"

# MongoDB. If unreachable, the app falls back to a JSON document store in ./data/mongodb_fallback
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="divorce_management_system"

# Secret used to sign session JWTs (change this for any shared deployment)
JWT_SECRET="change-me-to-a-long-random-string"
